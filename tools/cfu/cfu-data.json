  "questions": [
    { "id": "q1", "skill": "Understanding", "difficulty": "Easy", "type": "mcq",
      "prompt": "The bot's wheel turns on the rope. What stays still?",
      "options": ["The wheel", "The rope", "The bot"], "correct": 1,
      "feedback": "The rope stays still. The turning wheel moves itself, and the bot, along it." },
    { "id": "q2", "skill": "Understanding", "difficulty": "Easy", "type": "mcq",
      "prompt": "The wheel turns once. How far does the bot go?",
      "options": ["Across the wheel", "To the next tower", "Once around the wheel"], "correct": 2,
      "feedback": "One turn rolls the wheel's whole edge along the rope. Across the wheel is shorter than around it." },
    { "id": "q3", "skill": "Understanding", "difficulty": "Medium", "type": "mcq",
      "prompt": "Each turn moves the bot 10 cm. How many turns for 30 cm?",
      "options": ["3 turns", "10 turns", "30 turns"], "correct": 0,
      "feedback": "10, 20, 30: three turns. 30 turns would take the bot 300 cm." },
    { "id": "q4", "skill": "Reasoning", "difficulty": "Easy", "type": "mcq",
      "prompt": "The smooth wheel spun on the steep cable. Why?",
      "options": ["Motor too slow", "Wheel too small", "Not enough grip"], "correct": 2,
      "feedback": "A steeper cable needs more grip. The big smooth wheel slipped too, so size was not the problem." },
    { "id": "q5", "skill": "Reasoning", "difficulty": "Easy", "type": "mcq",
      "prompt": "The bot carried everything and stopped partway up. Why?",
